# Copy these into your shell environment (do NOT commit real keys).
# Linux/macOS:  export GROQ_API_KEY=your_key_here
# Windows PowerShell:  $env:GROQ_API_KEY="your_key_here"
GROQ_API_KEY=your_key_here
# off | groq | ollama   (unset = groq when GROQ_API_KEY is set, otherwise off)
SMOGGUARD_LLM=
GROQ_MODEL=openai/gpt-oss-120b
# Optional: pin "today" for relative dates such as "tomorrow" (YYYY-MM-DD)
SMOGGUARD_TODAY=
